<?xml version="1.0" encoding="UTF-8"?>
<!--
    Stock Management System
    Standalone Apache Ant build script (NetBeans-compatible layout).

    This project follows the standard NetBeans "Java Application" project
    layout (src/, build/, dist/, nbproject/). In a real NetBeans installation,
    opening this project would cause the IDE to auto-generate
    nbproject/build-impl.xml (an IDE-managed file that end users are not
    expected to hand-edit). To keep this build fully runnable from the
    command line with `ant` alone (without requiring the NetBeans IDE to be
    installed to regenerate that file), all real targets are defined
    directly in this build.xml.
-->
<project name="StockManagementSystem" default="default" basedir=".">

    <description>Builds, tests, and runs the Stock Management System project.</description>

    <!-- ===================== Properties ===================== -->
    <property name="src.dir"      value="src"/>
    <property name="test.dir"     value="test"/>
    <property name="build.dir"    value="build"/>
    <property name="classes.dir"  value="${build.dir}/classes"/>
    <property name="test.classes.dir" value="${build.dir}/test/classes"/>
    <property name="dist.dir"     value="dist"/>
    <property name="lib.dir"      value="lib"/>
    <property name="jar.name"     value="StockManagementSystem.jar"/>
    <property name="main.class"   value="com.stockms.Main"/>
    <property name="javac.source" value="17"/>
    <property name="javac.target" value="17"/>
    <property name="javac.encoding" value="UTF-8"/>

    <path id="project.classpath">
        <fileset dir="${lib.dir}" includes="**/*.jar"/>
    </path>

    <!-- ===================== Core Targets ===================== -->

    <target name="init" description="Create build/dist output directories">
        <mkdir dir="${classes.dir}"/>
        <mkdir dir="${test.classes.dir}"/>
        <mkdir dir="${dist.dir}"/>
        <mkdir dir="${lib.dir}"/>
    </target>

    <target name="compile" depends="init" description="Compile main source tree">
        <javac srcdir="${src.dir}"
               destdir="${classes.dir}"
               source="${javac.source}"
               target="${javac.target}"
               encoding="${javac.encoding}"
               includeantruntime="false"
               debug="true">
            <classpath refid="project.classpath"/>
        </javac>
        <copy todir="${classes.dir}">
            <fileset dir="${src.dir}" excludes="**/*.java"/>
        </copy>
    </target>

    <target name="compile-test" depends="compile" description="Compile unit test tree">
        <javac srcdir="${test.dir}"
               destdir="${test.classes.dir}"
               source="${javac.source}"
               target="${javac.target}"
               encoding="${javac.encoding}"
               includeantruntime="false"
               debug="true">
            <classpath>
                <path refid="project.classpath"/>
                <pathelement location="${classes.dir}"/>
            </classpath>
        </javac>
    </target>

    <target name="jar" depends="compile" description="Package compiled classes into a runnable JAR">
        <jar destfile="${dist.dir}/${jar.name}" basedir="${classes.dir}" manifest="manifest.mf">
            <fileset dir="${classes.dir}"/>
        </jar>
    </target>

    <target name="run" depends="jar" description="Run the packaged application">
        <java jar="${dist.dir}/${jar.name}" fork="true">
            <classpath>
                <path refid="project.classpath"/>
            </classpath>
        </java>
    </target>

    <target name="test" depends="compile-test" description="Run unit tests">
        <junit printsummary="yes" haltonfailure="no" fork="true">
            <classpath>
                <path refid="project.classpath"/>
                <pathelement location="${classes.dir}"/>
                <pathelement location="${test.classes.dir}"/>
            </classpath>
            <formatter type="plain" usefile="false"/>
            <batchtest>
                <fileset dir="${test.dir}" includes="**/*Test.java"/>
            </batchtest>
        </junit>
    </target>

    <target name="clean" description="Remove all build and dist output">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>

    <target name="default" depends="clean,jar" description="Full clean build producing the runnable JAR"/>

</project>
